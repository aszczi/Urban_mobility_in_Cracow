    "import zipfile\n",
    "import io\n",
    "\n",
    "def fetch_current_gtfs_static():\n",
    "    files = {\n",
    "        \"Tramwaje\": \"data/Tramwaje.zip\",\n",
    "        \"Autobusy\": \"data/Autobusy.zip\"\n",
    "    }\n",
    "    \n",
    "    all_stops = []\n",
    "    all_routes = []\n",
    "    \n",
    "    for v_type, filepath in files.items():\n",
    "        try:\n",
    "            print(f\"Ładowanie lokalnej bazy rozkładów (GTFS Zip) dla: {v_type}...\")\n",
    "            with open(filepath, 'rb') as f:\n",
    "                with zipfile.ZipFile(f) as z:\n",
    "                    # Rozpakowanie i ładowanie stops.txt\n",
    "                    with z.open('stops.txt') as zf:\n",
    "                        df_s = pd.read_csv(zf, dtype=str)\n",
    "                        df_s['typ'] = v_type # Tagujemy, aby zapobiec konfliktom ID\n",
    "                        all_stops.append(df_s)\n",
    "                    # Rozpakowanie i ładowanie routes.txt\n",
    "                    with z.open('routes.txt') as zf:\n",
    "                        df_r = pd.read_csv(zf, dtype=str)\n",
    "                        df_r['typ'] = v_type\n",
    "                        all_routes.append(df_r)\n",
    "        except Exception as e:\n",
    "            print(f\"Błąd ładowania statycznego GTFS dla {v_type}: {e}\")\n",
    "            \n",
    "    df_stops = pd.concat(all_stops, ignore_index=True) if all_stops else pd.DataFrame()\n",
    "    df_routes = pd.concat(all_routes, ignore_index=True) if all_routes else pd.DataFrame()\n",
    "    \n",
    "    return df_stops, df_routes\n",
    "\n",
    "\n",
    "if not df_delays.empty:\n",
    "    df_stops, df_routes = fetch_current_gtfs_static()\n",
    "    \n",
    "    if not df_stops.empty:\n",
    "        df_stops[\"stop_lat\"] = pd.to_numeric(df_stops[\"stop_lat\"], errors=\"coerce\")\n",
    "        df_stops[\"stop_lon\"] = pd.to_numeric(df_stops[\"stop_lon\"], errors=\"coerce\")\n",
    "        \n",
    "        # Łączymy po stop_id oraz typ (Autobusy z Autobusami, Tramwaje z Tramwajami)\n",
    "        df_merged = df_delays.merge(\n",
    "            df_stops[['stop_id', 'typ', 'stop_name', 'stop_lat', 'stop_lon']], \n",
    "            on=['stop_id', 'typ'], \n",
    "            how='inner'\n",
    "        )\n",
    "        \n",
    "        if not df_routes.empty:\n",
    "            df_merged = df_merged.merge(\n",
    "                df_routes[['route_id', 'typ', 'route_short_name']], \n",
    "                left_on=['line_num', 'typ'], \n",
    "                right_on=['route_id', 'typ'],\n",
    "                how='left'\n",
    "            )\n",
    "            df_merged['linia'] = df_merged['route_short_name'].fillna(df_merged['line_num'])\n",
    "        else:\n",
    "            df_merged['linia'] = df_merged['line_num']\n",
    "\n",
    "        # Grupowanie\n",
    "        df_stops_delays = df_merged.groupby(['stop_name', 'stop_lat', 'stop_lon', 'typ'], as_index=False).agg(\n",
    "            mean_delay_min=('delay_min', 'mean'),\n",
    "            max_delay_min=('delay_min', 'max'),\n",
    "            measurements_count=('delay_min', 'count')\n",
    "        )\n",
    "        \n",
    "        df_stops_delays = df_stops_delays[df_stops_delays['measurements_count'] >= 2]\n",
    "        \n",
    "        display(df_stops_delays.sort_values(by='mean_delay_min', ascending=False).head())\n",
    "    else:\n",
    "        print(\"Nie udało się pobrać aktualnej bazy przystanków z ZTP.\")\n",
    "        df_merged = pd.DataFrame()\n",
    "else:\n",
    "    print(\"Brak danych opóźnień - upewnij się, ze dane GTFS-RT zostały poprawnie pobrane.\")\n",
    "    df_merged = pd.DataFrame()\n",
    ""

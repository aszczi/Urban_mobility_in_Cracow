            "application/vnd.google.colaboratory.intrinsic+json": {
              "type": "dataframe",
              "summary": "{\n  \"name\": \"    print(\\\"Brak danych op\\u00f3\\u017anie\\u0144 \\u2013 uruchom kom\\u00f3rk\\u0119 pobierania GTFS-RT ponownie\",\n  \"rows\": 15,\n  \"fields\": [\n    {\n      \"column\": \"stop_name\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 15,\n        \"samples\": [\n          \"Zes\\u0142awice\",\n          \"\\u0141obz\\u00f3w SKA\",\n          \"Wzg\\u00f3rza Krzes\\u0142awickie\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"stop_lat\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.010276371974212219,\n        \"min\": 50.07345,\n        \"max\": 50.10625,\n        \"num_unique_values\": 15,\n        \"samples\": [\n          50.10625,\n          50.08165,\n          50.09546\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"stop_lon\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.06640390961668516,\n        \"min\": 19.91601,\n        \"max\": 20.07121,\n        \"num_unique_values\": 15,\n        \"samples\": [\n          20.04388,\n          19.91634,\n          20.06549\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"typ\",\n      \"properties\": {\n        \"dtype\": \"category\",\n        \"num_unique_values\": 1,\n        \"samples\": [\n          \"Autobusy\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"mean_delay_min\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.4716850352584578,\n        \"min\": 2.9,\n        \"max\": 3.8666666666666667,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          2.9\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"max_delay_min\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.4716850352584578,\n        \"min\": 2.9,\n        \"max\": 3.8666666666666667,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          2.9\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"measurements_count\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0,\n        \"min\": 1,\n        \"max\": 1,\n        \"num_unique_values\": 1,\n        \"samples\": [\n          1\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
            }
